# Copy this file to .env (already gitignored) and fill in real values.
# Loaded automatically by electron.vite.config.ts for `npm run dev`.

# Spotify Developer Dashboard (developer.spotify.com/dashboard) client id
# for this app's registered redirect URI, http://127.0.0.1:61823/callback
# (must be registered with that exact port — a portless loopback URI is
# rejected by the dashboard's own form). See main/spotify/auth.ts.
SPOTIFY_CLIENT_ID=
